#!/bin/bash
# julgi: Julgi가 띄운 세션이 Julgi에게 말을 거는 통로.
# 읽기는 ~/.julgi의 파일을 직접 보고, 부탁은 ~/.julgi/inbox에 적어 두면 Julgi가 1~2초 안에 가져가 처리한다.
ROOT="$HOME/.julgi"
INDEX="$ROOT/index.tsv" # 줄기id, 최근세션id, 세션id들, 레포, 상태, 이름, 요약 (탭으로 나눔)
me="${JULGI_SESSION:-}"

need_me() {
  [ -n "$me" ] || { echo "Julgi가 띄운 세션에서만 쓸 수 있다 (JULGI_SESSION이 없다)" >&2; exit 1; }
}
# ask <명령> <대상> : 본문은 표준 입력에서 읽는다
ask() {
  need_me
  mkdir -p "$ROOT/inbox"
  local file="$ROOT/inbox/$(date +%s)-$$-$RANDOM"
  { printf '%s\n%s\n%s\n' "$1" "$me" "$2"; cat; } > "$file.tmp" && mv "$file.tmp" "$file.req"
}
# 이름·레포·요약에 글이 들어 있는 줄기 (비우면 전부)
rows() {
  awk -F'\t' -v q="$1" 'q == "" || index(tolower($0), tolower(q))' "$INDEX" 2>/dev/null
}
mine() {
  awk -F'\t' -v id="$me" 'index("," $3 ",", "," id ",")' "$INDEX" 2>/dev/null | head -1
}
show_memory() {
  local thread session found=0
  thread=$(printf '%s' "$1" | cut -f1)
  session=$(printf '%s' "$1" | cut -f2)
  for id in "$thread" "$session"; do
    if [ -s "$ROOT/threads/$id.md" ]; then cat "$ROOT/threads/$id.md"; echo; found=1; fi
  done
  [ "$found" = 1 ] || echo "(이 줄기에는 아직 적힌 기억이 없다)"
}

case "${1:-}" in
  threads)
    rows "${2:-}" | head -60 | awk -F'\t' '{ printf "%s  [%s · %s]\n", $6, $4, $5; if ($7 != "") printf "    %s\n", $7 }'
    ;;
  memory)
    if [ -n "${2:-}" ]; then line=$(rows "$2" | head -1); else need_me; line=$(mine); fi
    [ -n "$line" ] || { echo "(맞는 줄기가 없다)"; exit 0; }
    printf '%s\n\n' "$(printf '%s' "$line" | cut -f6)"
    show_memory "$line"
    ;;
  note)
    shift
    [ -n "$*" ] || { echo "쓸 내용을 준다: julgi note \"결정: ...\"" >&2; exit 1; }
    printf '%s\n' "$*" | ask note ""
    echo "줄기 기억에 적어 달라고 했다."
    ;;
  send)
    [ -n "${2:-}" ] && [ -n "${3:-}" ] || { echo "쓰는 법: julgi send <줄기 이름 일부 | new> \"시킬 말\"" >&2; exit 1; }
    target="$2"; shift 2
    printf '%s\n' "$*" | ask send "$target"
    echo "보내 달라고 했다. 답은 그 세션에 쌓이고, 나는 기다리지 않는다."
    ;;
  handoff)
    printf '' | ask handoff ""
    echo "이 답이 끝나면 인계 글을 받아 새 세션으로 넘어가 달라고 했다."
    ;;
  done)
    printf '' | ask done ""
    echo "이 일을 끝난 것으로 해 달라고 했다."
    ;;
  brain)
    shift
    hits=""
    for f in "$ROOT"/brain/*.md; do
      [ -f "$f" ] || continue
      ok=0
      if [ -z "$*" ]; then ok=1; else for w in $*; do grep -qiF -- "$w" "$f" && ok=1; done; fi
      [ "$ok" = 1 ] || continue
      id=$(basename "$f" .md)
      title=$(sed -n 's/^title: //p' "$f" | head -1); kind=$(sed -n 's/^type: //p' "$f" | head -1)
      if [ -z "$*" ]; then printf '[%s] (%s) %s\n' "$id" "$kind" "$title"
      else printf '[%s] (%s) %s\n' "$id" "$kind" "$title"; awk 'n >= 2 && NF { print "    " $0 } /^---$/ { n++ }' "$f"; hits="$hits $id"; fi
    done
    # 찾아본 노트를 Julgi가 세어 둔다
    [ -n "$hits" ] && [ -n "$me" ] && printf '%s\n' "$hits" | ask used ""
    [ -n "$hits" ] || [ -z "$*" ] || echo "(맞는 노트가 없다)"
    ;;
  learn)
    [ -n "${2:-}" ] && [ -n "${3:-}" ] && [ -n "${4:-}" ] || { echo "쓰는 법: julgi learn <결정|함정|사실> \"제목\" \"본문\"" >&2; exit 1; }
    printf '%s\n%s\n' "$3" "$4" | ask learn "$2"
    echo "브레인에 담아 달라고 했다."
    ;;
  fix)
    [ -n "${2:-}" ] && [ -n "${3:-}" ] || { echo "쓰는 법: julgi fix <노트 id> \"고친 본문\"" >&2; exit 1; }
    printf '%s\n' "$3" | ask fix "$2"
    echo "노트를 고쳐 달라고 했다."
    ;;
  forget)
    [ -n "${2:-}" ] || { echo "쓰는 법: julgi forget <노트 id> \"틀린 이유\"" >&2; exit 1; }
    printf '%s\n' "${3:-}" | ask forget "$2"
    echo "노트를 지워 달라고 했다."
    ;;
  skill)
    # 다듬기 세션이 쓴다: ~/.julgi/grown/revised/<이름>/SKILL.md 를 진짜 스킬 자리에 넣어 달라고 한다
    [ "${2:-}" = "apply" ] && [ -n "${3:-}" ] || { echo "쓰는 법: julgi skill apply <스킬 이름> \"무엇을 왜 바꿨는지\"" >&2; exit 1; }
    [ -s "$ROOT/grown/revised/$3/SKILL.md" ] || { echo "고친 글이 없다: $ROOT/grown/revised/$3/SKILL.md" >&2; exit 1; }
    printf '%s\n' "${4:-}" | ask skill "$3"
    echo "스킬을 바꿔 넣어 달라고 했다. 옛 글은 ~/.julgi/skill-history/$3 에 남는다."
    ;;
  map)
    [ -s "$ROOT/MAP.md" ] || { echo "(지도가 아직 없다. Julgi가 레포를 훑어 만든다)"; exit 0; }
    if [ -z "${2:-}" ]; then cat "$ROOT/MAP.md"
    else awk -v q="$2" 'BEGIN { RS = "\n## "; IGNORECASE = 1 } NR == 1 { next } index(tolower($0), tolower(q)) { print "## " $0 }' "$ROOT/MAP.md"; fi
    ;;
  task)
    need_me
    TASKS="$ROOT/tasks.tsv" # 일감id, 상태, 레포, 맡긴 세션, 시킨 말, 결과 한 줄 (탭으로 나눔)
    # 내 줄기의 세션들이 맡긴 일감만 본다 (갈아타서 세션이 바뀌어도 이어지게)
    mine_ids=$(mine | cut -f3); [ -n "$mine_ids" ] || mine_ids="$me"
    own() { awk -F'\t' -v ids=",$mine_ids," 'index(ids, "," $4 ",")' "$TASKS" 2>/dev/null; }
    case "${2:-list}" in
      add)
        [ -n "${3:-}" ] && [ -n "${4:-}" ] || { echo "쓰는 법: julgi task add <레포이름> \"시킬 일\"" >&2; exit 1; }
        id="t$(LC_ALL=C tr -dc 'a-z0-9' < /dev/urandom | head -c 4)"
        printf '%s\n' "$4" | ask task "$id|$3"
        echo "일감 $id 을 $3 에 맡겼다. 끝나면 Julgi가 결과를 이 세션에 넣어 준다. 기다리며 되풀이해 확인하지 않는다."
        ;;
      list)
        rows=$(own)
        [ -n "$rows" ] || { echo "(맡긴 일감이 없다)"; exit 0; }
        printf '%s\n' "$rows" | awk -F'\t' '{ printf "%s  [%s · %s]  %s\n", $1, $2, $3, $5; if ($6 != "") printf "      → %s\n", $6 }'
        ;;
      result)
        [ -n "${3:-}" ] || { echo "쓰는 법: julgi task result <일감 id>" >&2; exit 1; }
        own | cut -f1 | grep -qx "$3" || { echo "(내가 맡긴 일감이 아니다: $3)"; exit 0; }
        [ -s "$ROOT/tasks/$3.md" ] && cat "$ROOT/tasks/$3.md" || echo "(아직 결과가 없다)"
        ;;
      redo)
        [ -n "${3:-}" ] && [ -n "${4:-}" ] || { echo "쓰는 법: julgi task redo <일감 id> \"더 시킬 말\"" >&2; exit 1; }
        printf '%s\n' "$4" | ask taskredo "$3"
        echo "일감 $3 을 맡았던 세션에 이어서 시켰다. 끝나면 결과가 다시 온다."
        ;;
      cancel)
        [ -n "${3:-}" ] || { echo "쓰는 법: julgi task cancel <일감 id>" >&2; exit 1; }
        printf '' | ask taskcancel "$3"
        echo "일감 $3 을 더 기다리지 않는다."
        ;;
      *) echo "쓰는 법: julgi task add|list|result|redo|cancel" >&2; exit 1 ;;
    esac
    ;;
  whoami)
    need_me
    line=$(mine)
    [ -n "$line" ] && printf '%s\n' "$line" | awk -F'\t' '{ printf "%s  [%s · %s]\n", $6, $4, $5 }' || echo "(아직 목록에 없는 새 세션: $me)"
    ;;
  *)
    cat <<'USAGE'
julgi threads [글]          줄기 목록 (글이 있으면 이름·레포·요약에서 찾는다)
julgi memory [글]           내 줄기의 기억, 또는 글에 맞는 줄기의 기억
julgi note "내용"           내 줄기 기억에 한 줄 적기
julgi send <줄기|new> "말"  다른 줄기(또는 새 줄기)에 일을 넘기기
julgi handoff               이 세션이 커졌을 때 새 세션으로 넘어가기
julgi done                  이 일을 끝난 것으로 하기
julgi brain [글]            브레인에서 찾기 (전에 알게 된 결정, 함정, 사실)
julgi learn <종류> "제목" "본문"   브레인에 남기기 (종류: 결정, 함정, 사실)
julgi fix <id> "본문"       틀린 브레인 노트 고치기
julgi forget <id> "이유"    성립하지 않는 브레인 노트 지우기
julgi map [글]              레포 지도: 다른 레포가 어디 있고 무엇을 하는지
julgi task add <레포> "일"  일감을 다른 세션에 맡기기 (끝나면 결과가 이 세션으로 온다)
julgi task list             내가 맡긴 일감들
julgi task result <id>      끝난 일감의 결과 전체
julgi task redo <id> "말"   같은 세션에 이어서 시키기
julgi task cancel <id>      일감을 더 기다리지 않기
julgi whoami                내가 어느 줄기인지
USAGE
    ;;
esac
