#!/bin/bash
# julgi: Julgi가 띄운 세션이 Julgi에게 말을 거는 통로.
# 읽기는 ~/.julgi의 파일을 직접 보고, 부탁은 ~/.julgi/inbox에 적어 두면 Julgi가 1~2초 안에 가져가 처리한다.
ROOT="$HOME/.julgi"
INDEX="$ROOT/index.tsv" # 줄기id, 최근세션id, 세션id들, 레포, 상태, 이름, 요약 (탭으로 나눔)
me="${JULGI_SESSION:-}"
# 글의 언어: Julgi가 켤 때 ~/.julgi/lang 에 ko 또는 en 을 적어 둔다. 없으면 영어다
[ "$(cat "$ROOT/lang" 2>/dev/null)" = ko ] && KO=1 || KO=0
say() { if [ "$KO" = 1 ]; then printf '%s\n' "$1"; else printf '%s\n' "$2"; fi; }
# 파일에 한국어로 적힌 상태·종류 낱말은 영어일 때 보여 주는 자리에서만 옮긴다 (파일의 값은 그대로다)
# 낱말은 == 로 견주지 않고 표에서 찾는다: macOS awk의 == 는 서로 다른 한글 낱말을 같다고 본다
WORD='BEGIN { split("열림 open 잠듦 asleep 끝남 ended 대기 waiting 실패 failed 멈춤 stopped 결정 decision 함정 pitfall 사실 fact 선호 preference", p, " "); for (i = 1; i < 21; i += 2) EN[p[i]] = p[i + 1]; EN["하는 중"] = "running" } function w(s) { return (!ko && (s in EN)) ? EN[s] : s }'

need_me() {
  [ -n "$me" ] || { say "Julgi가 띄운 세션에서만 쓸 수 있다 (JULGI_SESSION이 없다)" "Only works in a session started by Julgi (JULGI_SESSION is not set)" >&2; exit 1; }
}
# ask <명령> <대상> : 본문은 표준 입력에서 읽는다
ask() {
  need_me
  mkdir -p "$ROOT/inbox"
  local file="$ROOT/inbox/$(date +%s)-$$-$RANDOM"
  { printf '%s\n%s\n%s\n' "$1" "$me" "$2"; cat; } > "$file.tmp" && mv "$file.tmp" "$file.req"
}
# 이름·레포·요약에 글이 들어 있는 줄기 (비우면 전부)
rows() {
  awk -F'\t' -v q="$1" 'q == "" || index(tolower($0), tolower(q))' "$INDEX" 2>/dev/null
}
mine() {
  awk -F'\t' -v id="$me" 'index("," $3 ",", "," id ",")' "$INDEX" 2>/dev/null | head -1
}
# 이 세션에 이어진 티켓과 지금 Jira 상태 한 줄. Julgi가 session-tickets.tsv에 적어 둔 것을 읽는다 (세션 ID, 키, 상태, 범주).
# 이어진 티켓이 없으면 아무것도 찍지 않고 1을 돌려준다
ticket_line() {
  [ -n "$me" ] && [ -s "$ROOT/session-tickets.tsv" ] || return 1
  awk -F'\t' -v id="$me" -v ko="$KO" '
    $1 == id {
      st = $3; note = ""
      if ($4 == "done") note = (ko == 1 ? "끝남" : "finished")
      else if ($3 == "") { st = (ko == 1 ? "상태 모름" : "status unknown"); note = (ko == 1 ? "Jira에서 확인하지 못했다" : "could not check Jira") }
      else note = (ko == 1 ? "아직 안 끝남" : "not finished yet")
      if (ko == 1) printf "이 세션의 티켓: %s · %s (%s)\n", $2, st, note
      else printf "Ticket of this session: %s · %s (%s)\n", $2, st, note
      found = 1
    }
    END { exit found ? 0 : 1 }' "$ROOT/session-tickets.tsv"
}
show_memory() {
  local thread session found=0
  thread=$(printf '%s' "$1" | cut -f1)
  session=$(printf '%s' "$1" | cut -f2)
  for id in "$thread" "$session"; do
    if [ -s "$ROOT/threads/$id.md" ]; then cat "$ROOT/threads/$id.md"; echo; found=1; fi
  done
  [ "$found" = 1 ] || say "(이 줄기에는 아직 적힌 기억이 없다)" "(no memory written for this stem yet)"
}

case "${1:-}" in
  threads)
    rows "${2:-}" | head -60 | awk -F'\t' -v ko="$KO" "$WORD"'{ printf "%s  [%s · %s]\n", $6, $4, w($5); if ($7 != "") printf "    %s\n", $7 }'
    ;;
  memory)
    if [ -n "${2:-}" ]; then line=$(rows "$2" | head -1); else need_me; line=$(mine); fi
    [ -n "$line" ] || { say "(맞는 줄기가 없다)" "(no matching stem)"; exit 0; }
    printf '%s\n\n' "$(printf '%s' "$line" | cut -f6)"
    show_memory "$line"
    # 내 줄기를 볼 때는 이어진 티켓의 지금 상태도 같이 보인다
    [ -n "${2:-}" ] || ticket_line || true
    ;;
  note)
    shift
    [ -n "$*" ] || { say "쓸 내용을 준다: julgi note \"결정: ...\"" "Give the text to write: julgi note \"Decision: ...\"" >&2; exit 1; }
    printf '%s\n' "$*" | ask note ""
    say "줄기 기억에 적어 달라고 했다." "Asked Julgi to write it to stem memory."
    ;;
  send)
    [ -n "${2:-}" ] && [ -n "${3:-}" ] || { say "쓰는 법: julgi send <줄기 이름 일부 | new> \"시킬 말\"" "Usage: julgi send <part of a stem name | new> \"what to ask\"" >&2; exit 1; }
    target="$2"; shift 2
    printf '%s\n' "$*" | ask send "$target"
    say "보내 달라고 했다. 답은 그 세션에 쌓이고, 나는 기다리지 않는다." "Asked Julgi to send it. The reply stays in that session; do not wait for it."
    ;;
  event)
    # 바깥 도구(메신저, 메일, 일정, cron …)가 봇을 깨울 일을 넣는다. Julgi가 띄운 세션이 아니어도 쓸 수 있다.
    # julgi event <이름> "제목"  (본문은 표준 입력, 없어도 된다). 봇은 깨우는 일 "event"에 그 이름을 적어 둔다
    [ -n "${2:-}" ] && [ -n "${3:-}" ] || { say "쓰는 법: julgi event <이름> \"제목\"  (본문은 표준 입력으로 줄 수 있다)" "Usage: julgi event <name> \"title\"  (the body can come on standard input)" >&2; exit 1; }
    mkdir -p "$ROOT/inbox"
    file="$ROOT/inbox/$(date +%s)-$$-$RANDOM"
    { printf 'event\next\n%s\n%s\n' "$2" "$3"; [ -t 0 ] || cat; } > "$file.tmp" && mv "$file.tmp" "$file.req"
    say "봇을 깨울 일로 넣었다. 이 이름을 기다리는 봇이 있으면 깬다." "Queued as an event. Any bot waiting for this name wakes up."
    ;;
  handoff)
    printf '' | ask handoff ""
    say "이 답이 끝나면 인계 글을 받아 새 세션으로 넘어가 달라고 했다." "Asked Julgi to take a handoff note when this reply ends and move to a new session."
    ;;
  done)
    printf '' | ask done ""
    say "이 일을 끝난 것으로 해 달라고 했다." "Asked Julgi to mark this work as done."
    # 줄기를 끝내는 것과 Jira 티켓을 닫는 것은 다른 일이다. 티켓이 안 끝났으면 알려 준다
    if ticket_line; then
      awk -F'\t' -v id="$me" '$1 == id && $4 != "done" { found = 1 } END { exit found ? 0 : 1 }' "$ROOT/session-tickets.tsv" 2>/dev/null &&
        say "줄기만 끝났다. Jira 티켓은 그대로다. 사용자가 티켓도 닫으라고 했으면: julgi ticket move \"<상태 이름>\" (모르면 사용자에게 묻는다). 닫지 않았으면 기억에 \"티켓 종료\"라고 적지 않는다." "Only the stem is finished. The Jira ticket is unchanged. If the user asked to close the ticket too: julgi ticket move \"<status name>\" (ask the user if unsure). Do not write \"ticket closed\" to memory unless it is."
    fi
    ;;
  ticket)
    need_me
    if [ "${2:-}" = "move" ]; then
      [ -n "${3:-}" ] || { say "쓰는 법: julgi ticket move \"<옮길 상태 이름>\"" "Usage: julgi ticket move \"<status name>\"" >&2; exit 1; }
      ticket_line >/dev/null || { say "(이 세션에 이어진 티켓이 없다)" "(no ticket is tied to this session)"; exit 0; }
      printf '%s\n' "$3" | ask ticketmove ""
      say "티켓을 \"$3\"로 옮겨 달라고 했다. 몇 초 뒤 julgi ticket으로 바뀌었는지 확인한다. 그 이름의 전환이 없으면 바뀌지 않는다." "Asked Julgi to move the ticket to \"$3\". Check with julgi ticket in a few seconds. Nothing changes if there is no transition by that name."
    else
      ticket_line || say "(이 세션에 이어진 티켓이 없다)" "(no ticket is tied to this session)"
    fi
    ;;
  brain)
    shift
    hits=""
    for f in "$ROOT"/brain/*.md; do
      [ -f "$f" ] || continue
      ok=0
      if [ -z "$*" ]; then ok=1; else for w in $*; do grep -qiF -- "$w" "$f" && ok=1; done; fi
      [ "$ok" = 1 ] || continue
      id=$(basename "$f" .md)
      title=$(sed -n 's/^title: //p' "$f" | head -1); kind=$(sed -n 's/^type: //p' "$f" | head -1 | awk -v ko="$KO" "$WORD"'{ print w($0) }')
      if [ -z "$*" ]; then printf '[%s] (%s) %s\n' "$id" "$kind" "$title"
      else printf '[%s] (%s) %s\n' "$id" "$kind" "$title"; awk 'n >= 2 && NF { print "    " $0 } /^---$/ { n++ }' "$f"; hits="$hits $id"; fi
    done
    # 찾아본 노트를 Julgi가 세어 둔다
    [ -n "$hits" ] && [ -n "$me" ] && printf '%s\n' "$hits" | ask used ""
    [ -n "$hits" ] || [ -z "$*" ] || say "(맞는 노트가 없다)" "(no matching note)"
    ;;
  learn)
    [ -n "${2:-}" ] && [ -n "${3:-}" ] && [ -n "${4:-}" ] || { say "쓰는 법: julgi learn <결정|함정|사실> \"제목\" \"본문\"" "Usage: julgi learn <decision|pitfall|fact> \"title\" \"body\"" >&2; exit 1; }
    # 영어 이름으로 받아도 부탁에는 앱이 읽는 한국어 값으로 적는다
    case "$2" in decision) kind="결정" ;; pitfall) kind="함정" ;; fact) kind="사실" ;; *) kind="$2" ;; esac
    printf '%s\n%s\n' "$3" "$4" | ask learn "$kind"
    say "브레인에 담아 달라고 했다." "Asked Julgi to add it to the brain."
    ;;
  fix)
    [ -n "${2:-}" ] && [ -n "${3:-}" ] || { say "쓰는 법: julgi fix <노트 id> \"고친 본문\"" "Usage: julgi fix <note id> \"corrected body\"" >&2; exit 1; }
    printf '%s\n' "$3" | ask fix "$2"
    say "노트를 고쳐 달라고 했다." "Asked Julgi to fix the note."
    ;;
  forget)
    [ -n "${2:-}" ] || { say "쓰는 법: julgi forget <노트 id> \"틀린 이유\"" "Usage: julgi forget <note id> \"why it is wrong\"" >&2; exit 1; }
    printf '%s\n' "${3:-}" | ask forget "$2"
    say "노트를 지워 달라고 했다." "Asked Julgi to delete the note."
    ;;
  skill)
    # 다듬기 세션이 쓴다: ~/.julgi/grown/revised/<이름>/SKILL.md 를 진짜 스킬 자리에 넣어 달라고 한다
    [ "${2:-}" = "apply" ] && [ -n "${3:-}" ] || { say "쓰는 법: julgi skill apply <스킬 이름> \"무엇을 왜 바꿨는지\"" "Usage: julgi skill apply <skill name> \"what changed and why\"" >&2; exit 1; }
    [ -s "$ROOT/grown/revised/$3/SKILL.md" ] || { say "고친 글이 없다: $ROOT/grown/revised/$3/SKILL.md" "No revised text: $ROOT/grown/revised/$3/SKILL.md" >&2; exit 1; }
    printf '%s\n' "${4:-}" | ask skill "$3"
    say "스킬을 바꿔 넣어 달라고 했다. 옛 글은 ~/.julgi/skill-history/$3 에 남는다." "Asked Julgi to swap the skill in. The old text is kept in ~/.julgi/skill-history/$3."
    ;;
  map)
    [ -s "$ROOT/MAP.md" ] || { say "(지도가 아직 없다. Julgi가 레포를 훑어 만든다)" "(no map yet. Julgi builds it by scanning the repos)"; exit 0; }
    if [ -z "${2:-}" ]; then cat "$ROOT/MAP.md"
    else awk -v q="$2" 'BEGIN { RS = "\n## "; IGNORECASE = 1 } NR == 1 { next } index(tolower($0), tolower(q)) { print "## " $0 }' "$ROOT/MAP.md"; fi
    ;;
  task)
    need_me
    TASKS="$ROOT/tasks.tsv" # 일감id, 상태, 레포, 맡긴 세션, 시킨 말, 결과 한 줄 (탭으로 나눔)
    # 내 줄기의 세션들이 맡긴 일감만 본다 (갈아타서 세션이 바뀌어도 이어지게)
    mine_ids=$(mine | cut -f3); [ -n "$mine_ids" ] || mine_ids="$me"
    own() { awk -F'\t' -v ids=",$mine_ids," 'index(ids, "," $4 ",")' "$TASKS" 2>/dev/null; }
    case "${2:-list}" in
      add)
        [ -n "${3:-}" ] && [ -n "${4:-}" ] || { say "쓰는 법: julgi task add <레포이름> \"시킬 일\"" "Usage: julgi task add <repo name> \"work to do\"" >&2; exit 1; }
        id="t$(LC_ALL=C tr -dc 'a-z0-9' < /dev/urandom | head -c 4)"
        printf '%s\n' "$4" | ask task "$id|$3"
        say "일감 $id 을 $3 에 맡겼다. 끝나면 Julgi가 결과를 이 세션에 넣어 준다. 기다리며 되풀이해 확인하지 않는다." "Handed task $id to $3. When it finishes, Julgi puts the result into this session. Do not poll while waiting."
        ;;
      list)
        rows=$(own)
        [ -n "$rows" ] || { say "(맡긴 일감이 없다)" "(no tasks handed out)"; exit 0; }
        printf '%s\n' "$rows" | awk -F'\t' -v ko="$KO" "$WORD"'{ printf "%s  [%s · %s]  %s\n", $1, w($2), $3, $5; if ($6 != "") printf "      → %s\n", $6 }'
        ;;
      result)
        [ -n "${3:-}" ] || { say "쓰는 법: julgi task result <일감 id>" "Usage: julgi task result <task id>" >&2; exit 1; }
        own | cut -f1 | grep -qx "$3" || { say "(내가 맡긴 일감이 아니다: $3)" "(not a task I handed out: $3)"; exit 0; }
        [ -s "$ROOT/tasks/$3.md" ] && cat "$ROOT/tasks/$3.md" || say "(아직 결과가 없다)" "(no result yet)"
        ;;
      redo)
        [ -n "${3:-}" ] && [ -n "${4:-}" ] || { say "쓰는 법: julgi task redo <일감 id> \"더 시킬 말\"" "Usage: julgi task redo <task id> \"what more to do\"" >&2; exit 1; }
        printf '%s\n' "$4" | ask taskredo "$3"
        say "일감 $3 을 맡았던 세션에 이어서 시켰다. 끝나면 결과가 다시 온다." "Sent follow-up work to the session that had task $3. The result comes again when it finishes."
        ;;
      cancel)
        [ -n "${3:-}" ] || { say "쓰는 법: julgi task cancel <일감 id>" "Usage: julgi task cancel <task id>" >&2; exit 1; }
        printf '' | ask taskcancel "$3"
        say "일감 $3 을 더 기다리지 않는다." "No longer waiting for task $3."
        ;;
      *) say "쓰는 법: julgi task add|list|result|redo|cancel" "Usage: julgi task add|list|result|redo|cancel" >&2; exit 1 ;;
    esac
    ;;
  whoami)
    need_me
    line=$(mine)
    [ -n "$line" ] && printf '%s\n' "$line" | awk -F'\t' -v ko="$KO" "$WORD"'{ printf "%s  [%s · %s]\n", $6, $4, w($5) }' || say "(아직 목록에 없는 새 세션: $me)" "(a new session not in the list yet: $me)"
    ;;
  *)
    if [ "$KO" = 1 ]; then
    cat <<'USAGE'
julgi threads [글]          줄기 목록 (글이 있으면 이름·레포·요약에서 찾는다)
julgi memory [글]           내 줄기의 기억, 또는 글에 맞는 줄기의 기억
julgi note "내용"           내 줄기 기억에 한 줄 적기
julgi send <줄기|new> "말"  다른 줄기(또는 새 줄기)에 일을 넘기기
julgi handoff               이 세션이 커졌을 때 새 세션으로 넘어가기
julgi event <이름> "제목"  봇을 깨울 일 넣기 (본문은 표준 입력, 세션 밖에서도 쓴다)
julgi done                  이 일을 끝난 것으로 하기 (Jira 티켓은 닫지 않는다)
julgi ticket                이 세션에 이어진 티켓과 지금 Jira 상태
julgi ticket move "상태"    그 티켓을 그 상태로 옮기기
julgi brain [글]            브레인에서 찾기 (전에 알게 된 결정, 함정, 사실)
julgi learn <종류> "제목" "본문"   브레인에 남기기 (종류: 결정, 함정, 사실)
julgi fix <id> "본문"       틀린 브레인 노트 고치기
julgi forget <id> "이유"    성립하지 않는 브레인 노트 지우기
julgi map [글]              레포 지도: 다른 레포가 어디 있고 무엇을 하는지
julgi task add <레포> "일"  일감을 다른 세션에 맡기기 (끝나면 결과가 이 세션으로 온다)
julgi task list             내가 맡긴 일감들
julgi task result <id>      끝난 일감의 결과 전체
julgi task redo <id> "말"   같은 세션에 이어서 시키기
julgi task cancel <id>      일감을 더 기다리지 않기
julgi whoami                내가 어느 줄기인지
USAGE
    else
    cat <<'USAGE'
julgi threads [text]         list stems (with text, search names, repos, summaries)
julgi memory [text]          my stem's memory, or the memory of the stem matching text
julgi note "text"            write one line to my stem's memory
julgi send <stem|new> "ask"  hand work to another stem (or a new one)
julgi handoff                hand off to a new session when this one has grown too big
julgi event <name> "title"   queue an event that wakes bots (body on stdin; works outside sessions)
julgi done                   mark this work as done (does not close the Jira ticket)
julgi ticket                 the ticket tied to this session and its Jira status now
julgi ticket move "status"   move that ticket to that status
julgi brain [text]           search the brain (decisions, pitfalls, facts learned before)
julgi learn <kind> "title" "body"   save to the brain (kind: decision, pitfall, fact)
julgi fix <id> "body"        correct a wrong brain note
julgi forget <id> "why"      delete a brain note that no longer holds
julgi map [text]             repo map: where the other repos are and what they do
julgi task add <repo> "work" hand a task to another session (the result comes back here)
julgi task list              tasks I handed out
julgi task result <id>       full result of a finished task
julgi task redo <id> "ask"   send follow-up work to the same session
julgi task cancel <id>       stop waiting for a task
julgi whoami                 which stem I am
USAGE
    fi
    ;;
esac
